// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}/src",
				"--user-data-dir=${workspaceFolder}/.vscode/dev-user-data",
				"--extensions-dir=${workspaceFolder}/.vscode/dev-extensions",
				"--disable-extension", "github.codespaces",
				"--disable-extension", "github.vscode-pull-request-github",
				"--disable-extension", "saoudrizwan.claude-dev"
			],
			"outFiles": [
				"${workspaceFolder}/src/out/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		}
	]
}
